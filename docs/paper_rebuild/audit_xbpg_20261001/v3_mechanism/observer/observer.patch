+using mechanism_observer::Json;
+Json GIEngine::observerContext() const {
+  Json x;x.add("imu_seq",observer_imu_seq_).add("gnss_input_seq",observer_gnss_seq_)
+    .add("measurement_attempt_seq",observer_attempt_seq_).add("sa_seq",observer_current_sa_)
+    .add("ekf_seq",observer_ekf_seq_).add("source",observer_source_).add("row_id",observer_row_id_)
+    .add("measurement_time",observer_measurement_time_).add("gnss_time",gnssdata_.time)
+    .add("imu_previous_time",imupre_.time).add("imu_current_time",imucur_.time)
+    .add("state_time",pvacur_.time).add("res",observer_res_)
+    .add("gnss_update_count",update_count_).add("position_update_count",position_update_count_)
+    .add("velocity_update_count",velocity_update_count_).add("yaw_attempt_count",yaw_update_count_)
+    .add("yaw_reject_count",yaw_reject_count_).add("sa_active_evaluation_count",source_aware_evaluation_count_)
+    .add("raw_doppler_update_count",raw_doppler_status_.update_count)
+    .add("rp_update_count",go2_attitude_prior_status_.update_count)
+    .add("hv_update_count",go2_velocity_diagnostic_prior_status_.update_count);
+  return x;
+}
+Json GIEngine::observerState() const {
+  Json x;x.add("time",pvacur_.time).add("position_blh_rad_m",pvacur_.pos_blh_rad_m)
+    .add("velocity_ned_mps",pvacur_.vel_ned_mps).add("rpy_rad",pvacur_.euler_rad)
+    .add("Cbn",pvacur_.cbn).add("qbn_wxyz",std::array<double,4>{pvacur_.qbn.w,pvacur_.qbn.x,pvacur_.qbn.y,pvacur_.qbn.z})
+    .add("gyr_bias",imuerror_.gyrbias).add("acc_bias",imuerror_.accbias)
+    .add("gyr_scale",imuerror_.gyrscale).add("acc_scale",imuerror_.accscale)
+    .add("antlever_m",options_.antlever_m);
+  return x;
+}
+Json GIEngine::observerImu(const ImuData& a) const {
+  Json x;x.add("time",a.time).add("dt",a.dt).add("dtheta",a.dtheta).add("dvel",a.dvel).add("compensated",a.compensated);return x;
+}
+Json GIEngine::observerInput(const GnssData& a) const {
+  Json x;x.add("time",a.time).add("position_blh_rad_m",a.blh_rad_m).add("std_ned_m",a.std_ned_m)
+    .add("velocity_ned_mps",a.vel_ned_mps).add("vel_std_mps",a.vel_std_mps)
+    .add("yaw_rad",a.yaw_rad).add("yaw_std_rad",a.yaw_std_rad).add("yaw_deg",a.yaw_deg).add("yaw_std_deg",a.yaw_std_deg)
+    .add("has_position",a.has_position).add("has_velocity",a.has_velocity).add("has_yaw",a.has_yaw)
+    .add("flags_or",a.has_position||a.has_velocity||a.has_yaw).add("validity_explicit",a.validity_explicit)
+    .add("isvalid",a.isvalid).add("baseline_vector","UNKNOWN_NOT_IN_GNSS_STRUCT");return x;
+}
+Json GIEngine::observerInput(const RawDopplerVelocityMeasurement& a) const {
+  Json x;x.add("time",a.time).add("source_time",a.source_time).add("velocity_ned_mps",a.velocity_ned_mps)
+    .add("std_ned_mps",a.std_ned_mps).add("sat_count",a.sat_count).add("gdop_like",a.gdop_like)
+    .add("provider_status",a.provider_status).add("quality",a.quality).add("valid",a.valid)
+    .add("lineage_valid",a.lineage_valid).add("backend",a.raw_doppler_backend_id).add("covariance_policy",a.covariance_policy)
+    .add("update_flag","NOT_PRESENT").add("source_active","NOT_PRESENT");return x;
+}
+Json GIEngine::observerInput(const Go2AttitudeWeakPriorMeasurement& a) const {
+  Json x;x.add("time",a.time).add("roll_rad",a.roll_rad).add("pitch_rad",a.pitch_rad)
+    .add("std_roll_rad",a.std_roll_rad).add("std_pitch_rad",a.std_pitch_rad)
+    .add("source_status",a.source_status).add("quality_flag",a.quality_flag).add("mode",a.mode)
+    .add("gait_type",a.gait_type).add("foot_force_sum",a.foot_force_sum).add("body_height",a.body_height)
+    .add("valid","NOT_PRESENT").add("update_flag","NOT_PRESENT");return x;
+}
+Json GIEngine::observerInput(const Go2VelocityDiagnosticPriorMeasurement& a) const {
+  Json x;x.add("time",a.time).add("velocity_ned_mps",a.velocity_ned_mps).add("std_ned_mps",a.std_ned_mps)
