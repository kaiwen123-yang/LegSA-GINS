+#pragma once
+// Observation-only JSONL transport. No filter/policy calculations or shared state.
+#include "legsa_v23_port_core/types.hpp"
+#include <cmath>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <locale>
+#include <sstream>
+#include <stdexcept>
+#include <type_traits>
+
+namespace legsa_v23_port_core::mechanism_observer {
+inline void quote(std::ostream& s, const std::string& v) {
+  s << '"';
+  for (unsigned char c : v) {
+    if (c == '"' || c == '\\') s << '\\' << c;
+    else if (c == '\n') s << "\\n";
+    else if (c == '\r') s << "\\r";
+    else if (c == '\t') s << "\\t";
+    else if (c < 32) { const char* h="0123456789abcdef"; s << "\\u00" << h[c>>4] << h[c&15]; }
+    else s << c;
+  }
+  s << '"';
+}
+inline void value(std::ostream& s, const std::string& x) { quote(s,x); }
+inline void value(std::ostream& s, const char* x) { quote(s,x); }
+inline void value(std::ostream& s, bool x) { s << (x ? "true" : "false"); }
+template<typename T, typename std::enable_if<std::is_integral<T>::value && !std::is_same<T,bool>::value,int>::type=0>
+inline void value(std::ostream& s, T x) { s << x; }
+inline void value(std::ostream& s, double x) {
+  if (std::isfinite(x)) s << std::setprecision(17) << x;
+  else quote(s, std::isnan(x) ? "NaN" : (x > 0 ? "Infinity" : "-Infinity"));
+}
+template<typename T, std::size_t N> inline void value(std::ostream& s, const std::array<T,N>& x) {
+  s << '['; for (std::size_t i=0;i<x.size();++i) { if(i)s<<','; value(s,x[i]); } s << ']';
+}
+template<typename T> inline void value(std::ostream& s, const std::vector<T>& x) {
+  s << '['; for (std::size_t i=0;i<x.size();++i) { if(i)s<<','; value(s,x[i]); } s << ']';
+}
+inline void value(std::ostream& s, const Matrix& x) {
+  s << "{\"rows\":" << x.rows << ",\"cols\":" << x.cols << ",\"layout\":\"row_major\",\"data\":";
+  value(s,x.data);s << '}';
+}
+class Json {
+ public:
+  Json() { stream_.imbue(std::locale::classic()); stream_ << '{'; }
+  template<typename T> Json& add(const std::string& k, const T& v) { key(k); value(stream_,v); return *this; }
+  Json& raw(const std::string& k, const std::string& v) { key(k); stream_ << v; return *this; }
+  std::string str() const { return stream_.str() + '}'; }
+ private:
+  void key(const std::string& k) { if(!first_)stream_<<',';first_=false;quote(stream_,k);stream_<<':'; }
+  std::ostringstream stream_; bool first_=true;
+};
+class Log {
+ public:
+  Log() {
+    const char* dir=std::getenv("LEGSA_V3_OBSERVER_DIR");
+    if (!dir || !*dir) return;
+    const std::filesystem::path root(dir), path=root/"events.jsonl";
+    if(std::filesystem::exists(path))throw std::runtime_error("Observer refuses existing events.jsonl");
+    std::filesystem::create_directories(root);
+    output_.open(path,std::ios::out);output_.imbue(std::locale::classic());
+    if(!output_)throw std::runtime_error("Observer cannot open events.jsonl");
+    const char* id=std::getenv("LEGSA_V3_OBSERVER_RUN_ID");run_=id&&*id?id:root.filename().string();
+    write("OBSERVER_BEGIN",Json().add("schema","V3_MECHANISM_OBSERVER_1").add("double_precision",17).add("row_id_basis","zero_based_loaded_vector").add("shadow_formula_executed",false).str());
+  }
+  ~Log() noexcept {
+    if(!enabled())return;
+    try { write("OBSERVER_END",Json().add("prior_event_count",sequence_).str()); output_.flush();
+      if(!output_)std::cerr << "Observer final flush failed; event receipt incomplete\n";
+    } catch(const std::exception& e) { std::cerr << "Observer incomplete: " << e.what() << '\n'; }
+  }
+  bool enabled() const { return output_.is_open(); }
+  void write(const std::string& kind,const std::string& payload) {
+    if(!enabled())return;
+    Json envelope;envelope.add("event_seq",++sequence_).add("run_id",run_).add("event",kind).add("available_time","UNKNOWN").raw("data",payload);
+    output_<<envelope.str()<<'\n';
+    if(sequence_%128==0)output_.flush();
+    if(!output_)throw std::runtime_error("Observer event write failed");
+  }
+ private:
+  std::ofstream output_;std::string run_;std::size_t sequence_=0;
+};
+}  // namespace legsa_v23_port_core::mechanism_observer
