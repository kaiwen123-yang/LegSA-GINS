+void GIEngine::observerWeight(const source_aware::SourceMetadata& m,const source_aware::ObservationInnovation& i,
+                             const source_aware::SourceWeightResult& r,const std::vector<double>& dz,
+                             const Matrix& H,const Matrix& R,const Matrix& effective_R,bool source_enabled,bool qm_active) {
+  if(!observer_.enabled())return;
+  Json md;md.add("source",source_aware::toString(m.source)).add("time",m.time).add("valid",m.valid).add("std_xyz",m.std_xyz)
+    .add("yaw_std_rad",m.yaw_std_rad).add("residual_norm",m.residual_norm).add("time_diff_sec",m.time_diff_sec).add("sat_count",m.sat_count)
+    .add("provider_status",m.provider_status).add("quality_flag",m.quality_flag).add("covariance_available",m.covariance_available)
+    .add("rel_valid",m.rel_valid).add("ant_valid",m.ant_valid).add("ant_state",m.ant_state).add("baseline_length_m",m.baseline_length_m)
+    .add("rel_acc_m",m.rel_acc_m).add("spike_candidate",m.spike_candidate).add("go2_readiness_metadata_available",m.go2_readiness_metadata_available)
+    .add("go2_motion_state",m.go2_motion_state).add("go2_contact_label",m.go2_contact_label).add("go2_readiness_score",m.go2_readiness_score)
+    .add("go2_readiness_flag",m.go2_readiness_flag).add("go2_stance_stable",m.go2_stance_stable).add("go2_in_place_turn",m.go2_in_place_turn)
+    .add("go2_impact_or_rough",m.go2_impact_or_rough).add("go2_readiness_low",m.go2_readiness_low);
+  Json result;result.add("policy_version",r.policy_version).add("mode",r.mode).add("lsim_score",r.lsim_score).add("oim_score",r.oim_score)
+    .add("lsim_R_scale",r.lsim_R_scale).add("oim_R_scale",r.oim_R_scale).add("combined_R_scale",r.combined_R_scale).add("source_cap",r.source_cap)
+    .add("residual_norm",r.residual_norm).add("normalized_innovation",r.normalized_innovation).add("nis",r.nis).add("dof",r.dof)
+    .add("innovation_cov_trace",r.innovation_cov_trace).add("used_innovation_covariance",r.used_innovation_covariance)
+    .add("base_R_trace",r.base_R_trace).add("scaled_R_trace",r.scaled_R_trace).add("accepted",r.accepted).add("rejected",r.rejected)
+    .add("rolling_median",r.rolling_normalized_median).add("rolling_mad",r.rolling_normalized_mad).add("relative_anomaly_score",r.relative_anomaly_score)
+    .add("reason_codes",r.reason_codes).add("metadata_summary",r.metadata_summary)
+    .add("oim_alpha_available",r.observer_oim_alpha_available).add("oim_alpha",r.observer_oim_alpha_available?r.observer_oim_alpha:std::numeric_limits<double>::quiet_NaN())
+    .add("oim_multiplier",r.observer_oim_alpha_available?r.observer_oim_multiplier:std::numeric_limits<double>::quiet_NaN())
+    .add("oim_raw_scale",r.observer_oim_alpha_available?r.observer_oim_raw_scale:std::numeric_limits<double>::quiet_NaN());
+  Json original;original.add("nis",i.nis).add("dof",i.dof).add("normalized_innovation",i.normalized_innovation)
+    .add("used_innovation_covariance",i.used_innovation_covariance).add("residual_norm",i.residual_norm)
+    .add("base_R_trace",i.base_R_trace).add("hph_trace",i.hph_trace).add("innovation_cov_trace",i.innovation_cov_trace);
+  observerWrite("SA_EVALUATION",Json().add("dz",dz).add("H",H).add("dx_before",dx_).add("P_before",Cov_).add("base_R",R)
+    .add("effective_R",effective_R).raw("state",observerState().str()).raw("metadata",md.str()).raw("innovation",original.str())
+    .raw("result",result.str()).add("source_enabled",source_enabled).add("qm_active_scaling",qm_active));
+}
