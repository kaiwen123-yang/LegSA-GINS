+void GIEngine::observerCacheAuxiliary(double time) {
+  if(!observer_.enabled())return;
+  // This independent observer scan runs once per new GNSS input, never per IMU.
+  // It does not replace or advance the original helper selection. Equal distances
+  // choose the last vector row exactly as the original <= matching loop does.
+  auto candidates=[&](const auto& rows,double tolerance,auto eligible,bool config_enabled,bool solver_enabled,const std::string& provider) {
+    long long any=-1,selected=-1;double nearest=std::numeric_limits<double>::infinity(),selected_dt=tolerance;
+    std::size_t eligible_rows=0;
+    for(std::size_t i=0;i<rows.size();++i) {
+      const double dt=std::fabs(rows[i].time-time);
+      if(dt<=nearest){nearest=dt;any=static_cast<long long>(i);}
+      if(!eligible(rows[i]))continue;
+      ++eligible_rows;
+      if(dt<=selected_dt){selected_dt=dt;selected=static_cast<long long>(i);}
+    }
+    Json x;x.add("loaded_rows",rows.size()).add("selection_eligible_rows",eligible_rows).add("config_enabled",config_enabled)
+      .add("solver_enabled",solver_enabled).add("provider_status",provider).add("time_tolerance_sec",tolerance)
+      .add("nearest_any_row_id",any).add("selected_row_id",selected).add("measurement_time",time)
+      .add("match_found",selected>=0).add("tie_rule","LAST_VECTOR_ROW_AT_EQUAL_ABSOLUTE_TIME_DIFFERENCE");
+    if(any>=0)x.add("nearest_any_abs_dt",nearest).raw("nearest_any_input",observerInput(rows[any]).str());
+    if(selected>=0)x.add("selected_abs_dt",selected_dt).raw("selected_input",observerInput(rows[selected]).str());
+    x.add("match_reason",rows.empty()?"NO_LOADED_ROWS":eligible_rows==0?"NO_SELECTION_ELIGIBLE_ROWS":selected<0?"NO_TIME_MATCH":"TIME_MATCH_FOUND");return x.str();
+  };
+  Json x;x.raw("raw_doppler",candidates(raw_doppler_measurements_,options_.raw_doppler_config.raw_doppler_time_tolerance_sec,[](const auto&){return true;},options_.raw_doppler_config.enable_raw_doppler,raw_doppler_status_.solver_enabled,raw_doppler_status_.provider_status))
+    .raw("go2_roll_pitch",candidates(go2_attitude_priors_,options_.go2_attitude_prior_config.go2_attitude_prior_time_tolerance_sec,[](const auto&){return true;},options_.go2_attitude_prior_config.enable_go2_attitude_weak_prior,go2_attitude_prior_status_.solver_enabled,go2_attitude_prior_status_.provider_status))
+    .raw("go2_horizontal_velocity",candidates(go2_velocity_diagnostic_priors_,options_.go2_velocity_prior_diagnostic_config.go2_velocity_prior_time_tolerance_sec,[](const auto& a){return a.update_flag;},options_.go2_velocity_prior_diagnostic_config.enable_go2_velocity_prior_diagnostic,go2_velocity_diagnostic_prior_status_.solver_enabled,go2_velocity_diagnostic_prior_status_.provider_status));
+  observer_aux_cache_=x.str();
+}
