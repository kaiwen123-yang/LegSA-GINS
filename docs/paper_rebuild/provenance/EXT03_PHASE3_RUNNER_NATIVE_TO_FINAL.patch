+            continue
+        if native_index in used:
+            status = "REJECTED_NATIVE_REUSE"
+        elif native_index <= last_native_index_by_week.get(week,-1):
+            status = "REJECTED_NON_MONOTONIC_NATIVE_ASSOCIATION"
+        else:
