+def sha(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as handle:
+        for chunk in iter(lambda: handle.read(1 << 20), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def write_json(path, value):
+    with Path(path).open('x', encoding='utf-8') as handle:
+        handle.write(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True, allow_nan=False) + '\n')
+
+
+def observe_arrays(nav, errors, reference):
+    """Run the unchanged function and capture locals at its return, without edits."""
+    fn = wgs84.wgs84_consistency_check
