+        'east_difference_m': residual[:, 0], 'north_difference_m': residual[:, 1],
+        'horizontal_vector_discrepancy_m': hres,
+        'evaluator_up_error_m': actual[:, 2], 'observer_up_error_m': expected[:, 2],
+        'up_difference_m': residual[:, 2],
